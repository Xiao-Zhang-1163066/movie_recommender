// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  movies         Movie[]         @relation("MovieCreator") // Relation to movies created by the user
  watchlistItems WatchlistItem[]
  conversations  Conversation[]
}

model Movie {
  id             String                      @id @default(uuid())
  tmdbId         Int?                        @unique
  title          String
  overview       String?
  releaseYear    Int
  genres         String[]                    @default([])
  runtime        Int?
  voteAverage    Float?
  posterUrl      String?
  // Semantic search vector over title + genres + overview. Prisma has no vector
  // type, so `Unsupported` lets migrate own the column while keeping it out of
  // the generated client — every read and write of it is raw SQL.
  // 768 dimensions, not the model's full 3072: gemini-embedding-001 is a
  // Matryoshka model, so a truncated prefix is still a usable embedding at a
  // quarter of the storage and index size.
  embedding      Unsupported("vector(768)")?
  // sha256 of the exact text that was embedded. Re-running the backfill is then
  // free for unchanged rows, and an overview edited on TMDB re-embeds itself.
  embeddingHash  String?
  embeddedAt     DateTime?
  createdBy      String
  createdAt      DateTime                    @default(now())
  creator        User                        @relation("MovieCreator", fields: [createdBy], references: [id], onDelete: Cascade) // Ensure that if a user is deleted, the corresponding movies are also deleted
  watchlistItems WatchlistItem[]
  sessions       Session[]
}

model WatchlistItem {
  id        String          @id @default(uuid())
  userId    String
  movieId   String
  status    WatchlistStatus @default(PLANNED)
  rating    Int? // User rating for the movie (1-10)
  notes     String? // User notes about the movie
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now())

  //relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade) // Ensure that if a user or movie is deleted, the corresponding watchlist items are also deleted

  @@unique([userId, movieId]) // Ensure a user can only have one entry per movie in their watchlist
}

enum WatchlistStatus {
  PLANNED
  WATCHING
  COMPLETED
  DROPPED
}

model Cinema {
  id         String    @id @default(uuid())
  // cinema display name
  name       String
  // URL-safe identifier, must be unique                                                        
  slug       String    @unique
  // street address                                                                             
  address    String
  // Christchurch suburb                                                                        
  suburb     String
  // map coordinates
  latitude   Float
  longitude  Float
  // where users go to browse / buy tickets                                                     
  websiteUrl String
  bookingUrl String? // optional — not all cinemas have a direct booking page                 
  // where the scraper pulls showtime data from                                                 
  scrapeUrl  String
  // default to NZ timezone                                                                     
  timezone   String    @default("Pacific/Auckland")
  // soft-disable a cinema without deleting it                                                  
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  // relation field — list of all sessions at this cinema                                     
  sessions   Session[]
}

model Session {
  id              String   @id @default(uuid())
  // foreign keys
  cinemaId        String
  movieId         String
  // when the film starts
  startsAt        DateTime
  // e.g. "Standard", "IMAX", "3D"
  format          String   @default("Standard")
  // optional — scraper may not have this
  seatsTotal      Int?
  seatsRemaining  Int?
  // direct link to this specific session's booking page
  bookingUrl      String? // optional
  // the cinema's own internal ID for this session (for deep-linking)
  sourceSessionId String? // optional
  scrapedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  // relation back to Cinema
  cinema          Cinema   @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  // relation back to Movie
  movie           Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  // indexes for fast lookups
  @@index([movieId, startsAt])
  @@index([cinemaId, startsAt])
}

// One chat thread between a user and the agent. Before this model the whole
// conversation lived in React state and was re-sent on every request, so a
// refresh lost it and context grew without bound.
model Conversation {
  id             String   @id @default(uuid())
  userId         String
  // Taken from the first user message and truncated — no LLM call, so creating
  // a conversation stays a single cheap insert.
  title          String?
  // Rolling summary of every turn that has fallen outside the verbatim window.
  // One conversation only ever has one current summary, and superseded summaries
  // have no value once folded in, so this is a column rather than its own table.
  summary        String?
  // Watermark: the seq at which unsummarised history begins. Everything below
  // it is already folded into `summary`, so summarisation only ever reads rows
  // from here up, which is what makes a repeated run harmless. 0 means nothing
  // has been folded yet.
  summarizedUpTo Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  // Drives the "recent conversations" list, which reads by owner and sorts by recency.
  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           ChatRole
  content        String
  // recommend_movies card payload for assistant turns, null for user turns.
  // It is a TMDB snapshot that is only ever read and rendered whole — never
  // queried or joined — so jsonb beats a normalised table here.
  movies         Json?
  // Ordering key, monotonic within a conversation. createdAt is not enough:
  // the user and assistant rows of one turn can share a timestamp, and clocks
  // can move backwards. An explicit integer also gives the summary watermark
  // something simple to point at.
  seq            Int
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Guards against two concurrent writes claiming the same position. The unique
  // constraint is itself a btree index on (conversationId, seq), so it also
  // serves "load this conversation in order" — a separate @@index would be
  // redundant and would cost an extra tree to maintain on every insert.
  @@unique([conversationId, seq])
}

enum ChatRole {
  USER
  ASSISTANT
}

// One row per agent turn, written after the reply has been sent.
// Without this, everything we know about a turn is lost the moment it ends.
model AgentRun {
  id             String   @id @default(uuid())
  userId         String
  model          String
  // Nullable, not 0: a turn that failed before the model answered reported no
  // token counts at all, and storing 0 would look like a free turn instead.
  inputTokens    Int?
  outputTokens   Int?
  // Tool names in call order, duplicates kept. The order is the point:
  // "search_movies" eight times running is the signature of a model stuck in a
  // loop, and a count or a de-duplicated set would hide exactly that.
  toolCalls      String[] @default([])
  steps          Int?
  finishReason   String?
  // True when the first attempt produced no text and the no-tools retry ran.
  // Worth its own column because a retry is invisible to the user but is a
  // second model call, so a rising retry rate is a rising bill.
  retried        Boolean  @default(false)
  errored        Boolean  @default(false)
  // The same classification the user was shown ("rate_limit", "daily_limit",
  // "context_limit", "general"), so a spike here lines up with complaints.
  errorKind      String?
  // Loose reference, deliberately no foreign key. This is an append-only log,
  // and a cascade from Conversation would delete the very history it exists to
  // preserve.
  conversationId String?
  latencyMs      Int
  createdAt      DateTime @default(now())
}
